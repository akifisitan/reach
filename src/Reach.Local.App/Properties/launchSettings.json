{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Reach.Local.App Serve": {
      "commandName": "Project",
      "commandLineArgs": "serve"
    },
    "Reach.Local.App Echo": {
      "commandName": "Project",
      "commandLineArgs": "echo -m \"hello world\""
    },
    "Reach.Local.App Search Start": {
      "commandName": "Project",
      "commandLineArgs": "search start -s myserver -q hello"
    },
    "Reach.Local Setup Relay": {
      "commandName": "Project",
      "commandLineArgs": "setup relay"
    }
  }
}
