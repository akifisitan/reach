<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>reachrd</AssemblyName>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ZLogger" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Polly.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reach.Options\Reach.Options.csproj" />
    <ProjectReference Include="..\Reach.Infra.CommandResultOutbox\Reach.Infra.CommandResultOutbox.csproj" />
    <ProjectReference Include="..\Reach.Hosting\Reach.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
