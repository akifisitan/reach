<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <Import Project="Reach.Composition.buildconfig.targets" />
  <Import
    Project="Reach.Composition.buildconfig.props"
    Condition="Exists('Reach.Composition.buildconfig.props')"
  />
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="ZLogger" />
    <PackageReference Include="Polly.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reach.Infra.Persistence\Reach.Infra.Persistence.csproj" />
    <!-- Composition contains 1 relay + n plugins -->
    <!-- Relay -->
    <ProjectReference Include="..\Reach.Relay.Confluence\Reach.Relay.Confluence.csproj" />
    <ProjectReference Include="..\Reach.Relay.LocalFile\Reach.Relay.LocalFile.csproj" />
    <!-- Plugins -->
    <ProjectReference Include="..\Reach.Plugin.Example\Reach.Plugin.Example.csproj" />
    <ProjectReference Include="..\Reach.Plugin.LogSearch\Reach.Plugin.LogSearch.csproj" />
  </ItemGroup>
</Project>
