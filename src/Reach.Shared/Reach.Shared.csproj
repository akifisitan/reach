<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>$(LibVersion)</Version>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <Import Project="Reach.Shared.buildconfig.targets" />
  <Import
    Project="Reach.Shared.buildconfig.props"
    Condition="Exists('Reach.Shared.buildconfig.props')"
  />
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="ZLogger" />
    <PackageReference Include="Polly.Extensions" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reach.Persistence\Reach.Persistence.csproj" />
    <ProjectReference Include="..\Reach.Relay.Abstractions\Reach.Relay.Abstractions.csproj" />
    <!-- Shared contains 1 relay + n plugins -->
    <!-- Relay -->
    <ProjectReference Include="..\Reach.Relay.Confluence\Reach.Relay.Confluence.csproj" />
    <ProjectReference Include="..\Reach.Relay.LocalFile\Reach.Relay.LocalFile.csproj" />
    <!-- Plugins -->
    <ProjectReference Include="..\Reach.Plugin.Abstractions\Reach.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\Reach.Plugin.Example\Reach.Plugin.Example.csproj" />
    <ProjectReference Include="..\Reach.Plugin.LogSearch\Reach.Plugin.LogSearch.csproj" />
  </ItemGroup>
</Project>
